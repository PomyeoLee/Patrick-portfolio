# Local-only settings for `npm run dashboards:export`, which refreshes the dashboard snapshots in
# public/data/dashboards/. The deployed site does not need any of these.
#
# Copy to .env.local and fill in values. Do NOT commit .env.local.

DATABRICKS_WORKSPACE_URL="https://dbc-xxxxxxxx-xxxx.cloud.databricks.com"
DATABRICKS_WORKSPACE_ID="7474657136442266"

# COVID dashboard id (the e-commerce dashboard ids are listed in the export script)
DATABRICKS_DASHBOARD_ID="01f1360c3e9b1353b552230b71ad8da2"

# Service principal OAuth credentials (needs read access to the dashboards and their tables)
DATABRICKS_CLIENT_ID="<<YOUR_CLIENT_ID>>"
DATABRICKS_CLIENT_SECRET="<<YOUR_CLIENT_SECRET>>"

# SQL warehouse the dataset queries run on (service principal needs "Can use")
DATABRICKS_WAREHOUSE_ID=""

# Optional: tried when the service principal can't read a dataset's tables (e.g. a personal access token)
# DATABRICKS_SQL_TOKEN=""
